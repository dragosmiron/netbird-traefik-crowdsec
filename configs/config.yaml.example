# Combined NetBird Server Configuration (Management + Signal + Relay + STUN)

server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.example.com:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  # Generate random 32-character string with: openssl rand -base64 32
  authSecret: "GENERATE_RANDOM_BASE64_32_CHARS"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://netbird.example.com/oauth2"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://netbird.example.com/nb-auth"
      - "https://netbird.example.com/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.10/32"

  store:
    engine: "sqlite"
    # Generate random 32-character encryption key with: openssl rand -base64 32
    encryptionKey: "GENERATE_RANDOM_BASE64_32_CHARS"
